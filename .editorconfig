root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Formatting is owned by CSharpier (.csharpierrc.json); these only keep the IDE in line with it.
[*.cs]
indent_style = space
indent_size = 4
max_line_length = 100

# Events, commands, requests and responses are public records read by Marten, Wolverine,
# System.Text.Json and the OpenAPI generator - code never reads most of their properties,
# a serializer does. The local variants (private types) stay on.
resharper_not_accessed_positional_property_global_highlighting = none
resharper_unused_auto_property_accessor_global_highlighting = none

[*.{csproj,props,targets,xml,slnx}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Test names are sentences: Handle_WithValidCommand_ReturnsCompanyCreated,
# A_third_country_national_is_flagged_for_legalisation. Underscores are the separator, not a mistake.
[tests/**.cs]
resharper_inconsistent_naming_highlighting = none
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none
# An Assert inside a lambda is the point of the lambda, not a precondition check.
resharper_parameter_only_used_for_precondition_check_local_highlighting = none

# Wolverine discovers handlers by name - a class ending in Handler, a static Handle/HandleAsync -
# and NotificationWorker does the same. Nothing calls them, the generated code does, so "never
# used" here is a false positive by construction. The glob is the discovery rule itself.
[src/**/*Handler.cs]
resharper_unused_type_global_highlighting = none
resharper_unused_member_global_highlighting = none

# Request records are bound by Minimal APIs and stay internal so integration tests can send the
# same type the endpoint reads (CLAUDE.md, *API layer*); the binder is what instantiates them.
[src/HrAgencySystem.Api/Endpoints/**/Maps/*.cs]
resharper_class_never_instantiated_global_highlighting = none
resharper_member_can_be_private_global_highlighting = none
