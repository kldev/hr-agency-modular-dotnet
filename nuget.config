<?xml version="1.0" encoding="utf-8"?>
<!--
  The solution restores from nuget.org only. Without this file the machine-wide configuration
  decides, and any extra feed there turns central package management into NU1507 on every
  project - and into a restore that depends on whose machine it runs on.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
