{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host --port 4300",
		"build": "tsc -b && vite build",
		"format": "biome check --write .",
		"format:check": "biome format .",
		"lint": "oxlint",
		"preview": "vite preview",
		"check": "biome check . && oxlint . && tsc --noEmit",
		"api:gen": "orval && yarn format"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.102.8",
		"axios": "^1.20.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.43.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router-dom": "^7.18.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"orval": "^8.30.0",
		"oxlint": "^1.79.0",
		"typescript": "~6.0.2",
		"vite": "8.2.1"
	},
	"packageManager": "yarn@4.18.0"
}
