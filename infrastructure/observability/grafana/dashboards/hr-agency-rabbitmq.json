    {
      "type": "timeseries",
      "title": "Queue depth - x.emails queues",
      "description": "One durable queue per source domain (EmailQueues), bound to x.emails by <domain>.#. A backlog in one domain cannot stall another.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_ready{job=\"rabbitmq-queues\", queue=~\"q\\\\.emails\\\\..*\"})",
          "legendFormat": "{{queue}} ready",
          "refId": "A",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_unacked{job=\"rabbitmq-queues\", queue=~\"q\\\\.emails\\\\..*\"})",
          "legendFormat": "{{queue}} unacked",
          "refId": "B",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
