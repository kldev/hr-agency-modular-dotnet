          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hr_feeds_generation_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Feed file size p95 by format",
      "datasource": {
        "type": "prometheus",
