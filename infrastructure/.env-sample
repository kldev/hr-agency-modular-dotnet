SecretKey=SuperSecretKeyForDemoPurposesOnly-AtLeast32Bytes!
RustFsSecretKey=agent909
RustFsAccessKey=agent
FileServiceSecret=AnotherSecretForTheFileService-AtLeast32Bytes!
Cors=http://172.16.21.20
RabbitMqUser=hr_app
RabbitMqPassword=hr_app
FrontReplicaCount=1
ApiReplicaCount=1
EmailsWorkerReplicaCount=1
# Service key of the public job board (web). This value is the one the seeder writes
# (PlatformSeeder Config.JobBoardApiKey), so a seeded stack works as is. For anything else, issue
# a key as the platform owner in the panel (Admin -> API keys) - shown once - and put it here.
WebApiKey=sk_dev_public_job_board_seeded_key_not_a_secret
ReportsSecret=development-reports-service-secret-please-change-me
# Owner account the API creates at startup (optional; the dev seed creates admin@hr-agency.com too).
#HrAgencyEmail=admin@hr-agency.com
#HrAgencyPassword=
# Observability profile (./start.sh --observability). All optional - these are the defaults.
#GrafanaUser=admin
#GrafanaPassword=admin
#RootprintPublicUrl=http://localhost:8282
#RootprintAdminEmail=admin@hr-agency.com
#RootprintAdminPassword=rootprint-admin-local
#RootprintDbPassword=rootprint-local
#PostgresExporterPassword=postgres-exporter-local
#ObservabilityBucket=observability-logs
