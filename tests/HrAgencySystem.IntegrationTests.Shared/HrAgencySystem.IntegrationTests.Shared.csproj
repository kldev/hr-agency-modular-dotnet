<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>HrAgencySystem.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <!--
    Everything the integration test projects share: the API host over a PostgreSQL Testcontainer,
    the fakes, the database cleaner and the per-area test clients. Not a test project - xUnit only
    discovers [CollectionDefinition] in the assembly that holds the tests, so each test project
    declares its own IntegrationCollection over IntegrationEnvironment.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.assert" />
    <PackageReference Include="xunit.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test clients are internal: they send the API's internal request records. -->
    <InternalsVisibleTo Include="HrAgencySystem.IntegrationTests" />
    <InternalsVisibleTo Include="HrAgencySystem.IntegrationTests.Sales" />
    <InternalsVisibleTo Include="HrAgencySystem.IntegrationTests.Platform" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HrAgencySystem.Api\HrAgencySystem.Api.csproj" />
  </ItemGroup>
</Project>
