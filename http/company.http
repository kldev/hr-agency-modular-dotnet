@baseURL = http://localhost:5000

### Login Platform User
# @name login
POST {{baseURL}}/api/auth/login
Content-Type: application/json

{
    "email": "j.smith@hr-agency.com",
    "password": "test123",
    "slug": "hr-agency"
}

###
@token = {{login.response.body.$.token}}

### Create company
POST {{baseURL}}/api/companies
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "New company",
    "countryCode": "pl",
    "taxId": "PL8881001100",
    "registrationNumber": "KRS100000"
}

### Create company without name
POST {{baseURL}}/api/companies
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": " ",
    "countryCode": "pl",
    "taxId": "PL88{{$randomInt 1000 9999}}",
    "registrationNumber": "KRS100000"
}

###
@randomVal = {{$randomInt 1000 9999}}

### Create company
# @name createRandom
POST {{baseURL}}/api/companies
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "New company{{randomVal}}",
    "countryCode": "pl",
    "taxId": "PL88{{randomVal}}",
    "registrationNumber": "KRS{{randomVal}}",
    "industry": "Robotics",
    "website": "robots-are-fun.com"
}

###
@companyId = {{createRandom.response.body.$.companyId}}
###

### Update company
PUT {{baseURL}}/api/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "New company{{randomVal}}",
    "countryCode": "pl",    
    "registrationNumber": "KRS{{randomVal}}",
    "industry": "ECommerce",
    "website": "https://shop-with-us.com.fake"
}

### Update company
PUT {{baseURL}}/api/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "New company{{randomVal}}",
    "countryCode": "pl",    
    "registrationNumber": "KRS{{randomVal}}",
    "industry": "Woodworking",
    "website": "https://woods-with-us.com.fake"
}

###
@companyId = {{createRandom.response.body.$.companyId}}
###


### Get company
GET {{baseURL}}/api/companies/{{companyId}}
Authorization: Bearer {{token}}
Content-Type: application/json


### Get companies
GET {{baseURL}}/api/companies?pageSize=501
Authorization: Bearer {{token}}
Content-Type: application/json


### Get company
GET {{baseURL}}/api/companies/{{companyId}}
Authorization: Bearer {{token}}
Content-Type: application/json


### Get company
GET {{baseURL}}/api/companies/{{companyId}}
Authorization: Bearer {{token}}
Content-Type: application/json

