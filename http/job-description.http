### Vytvoření pracovní nabídky

POST {{baseURL}}/api/recruitment/job-posting
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "jobDescriptionId": "{{jdId}}",
  "title": "Java Backend Developer",
  "summary": "Senior",
  "description": "Hledáme zkušeného Java Backend Developera, který se připojí k našemu vývojovému týmu.",
  "responsibilities": [
    "Navrhovat a vyvíjet backendové aplikace",
    "Vyvíjet a udržovat REST API",
    "Psát unit a integrační testy",
    "Účastnit se code review",
    "Spolupracovat s frontendovými vývojáři",
    "Monitorovat a zlepšovat výkon aplikací"
  ],
  "requirements": [
    "Minimálně 3 roky zkušeností s Javou",
    "Praktické zkušenosti se Spring Boot",
    "Dobrá znalost relačních databází",
    "Zkušenosti s REST API",
    "Schopnost pracovat v týmu",
    "Dobrá znalost angličtiny"
  ],
  "skills": [
    "Java 21",
    "Spring Boot",
    "PostgreSQL",
    "REST API",
    "Docker",
    "Git"
  ],
  "location": "Opole",
  "countryCode": "PL",
  "languageCode": "CZ",
  "employmentType": "FullTime",
  "workMode": "OnSite",
  "currencyCode": "PLN",
  "salaryMin": 12000,
  "salaryMax": 15000,
  "recruiterId": "{{userId}}"
}

