@baseURL = http://localhost:5000

### Login Platform User
# @name login
POST {{baseURL}}/api/auth/login
Content-Type: application/json

{
    "email": "j.smith@hr-agency.com",
    "password": "test123",
    "slug": "hr-agency"
}

###
@token = {{login.response.body.$.token}}

###

### posting 
# @name postOne
GET {{baseURL}}/api/recruitment/job-posting?search=Spring
Authorization: Bearer {{token}}


###
@jobPostId1 = {{postOne.response.body.$.content[0].id}}
###

### posting 
# @name postTwo
GET {{baseURL}}/api/recruitment/job-posting?search=NextJS
Authorization: Bearer {{token}}

###
@jobPostId2 = {{postTwo.response.body.$.content[0].id}}
###

### posting 
# @name postThree
GET {{baseURL}}/api/recruitment/job-posting?search=NextJS
Authorization: Bearer {{token}}

###
@jobPostId3 = {{postThree.response.body.$.content[0].id}}
###


