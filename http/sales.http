POST {{baseURL}}/api/sales/activity
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "OpportunityId": "{{oportunityId}}",
    "Type": "Call",
    "Note": ""
}

###
# @name createActivity
POST {{baseURL}}/api/sales/activity
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "OpportunityId": "{{oportunityId}}",
    "Type": "Email",
    "Note": ""
}

###
# @name createActivity
POST {{baseURL}}/api/sales/activity
Authorization: Bearer {{token}}
