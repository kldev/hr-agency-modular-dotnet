<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
   <meta charset="utf-8">
   <meta name="viewport" content="width=device-width, initial-scale=1">
   <meta http-equiv="X-UA-Compatible" content="IE=edge">
   <meta name="x-apple-disable-message-reformatting">
   <title>Reset your HR Agency Portal password</title>
   <!--[if mso]>
   <style>
      * { font-family: Arial, Helvetica, sans-serif !important; }
      table { border-collapse: collapse; }
   </style>
   <![endif]-->
   <!--[if !mso]><!-->
   <style>
      * {
         font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }

      @media only screen and (max-width: 620px) {
         .content-padding { padding-left: 20px !important; padding-right: 20px !important; }
      }
   </style>
   <!--<![endif]-->
</head>

<body style="margin: 0; padding: 0; width: 100%; background-color: #f6f7f9; color: #17202a;">

<!-- Preheader: the preview line in the inbox list. -->
<div style="display: none; max-height: 0; overflow: hidden; mso-hide: all;">
   Set a new password for your HR Agency Portal account. The link expires in {{ ExpiresInMinutes }} minutes.
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="border-collapse: collapse; width: 100%; background-color: #f6f7f9;">
   <tr>
      <td align="center" style="padding: 32px 12px;">
         <!--[if mso]>
         <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td>
         <![endif]-->
         <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                style="border-collapse: collapse; width: 100%; max-width: 600px; background-color: #ffffff;
                       border: 1px solid #dfe3e8; border-radius: 4px;">

            {% include "Mail/header" %}

            <!-- Headline -->
            <tr>
               <td class="content-padding" style="padding: 32px 32px 0 32px;">
                  <div style="font-size: 11px; font-weight: 600; color: #2457a6; letter-spacing: 1.4px;
                              text-transform: uppercase;">
                     Password reset
                  </div>
                  <h1 style="margin: 10px 0 0 0; font-size: 22px; line-height: 30px; font-weight: 600; color: #17202a;">
                     Set a new password
                  </h1>
                  <p style="margin: 12px 0 0 0; font-size: 14px; line-height: 22px; color: #5f6b78;">
                     Hi {{ RecipientFullname }}, we received a request to reset the password for
                     <strong style="color: #17202a; font-weight: 600;">{{ RecipientEmail }}</strong>.
                     Choose a new one using the button below.
                  </p>
               </td>
            </tr>

            <!-- Call to action -->
            <tr>
               <td class="content-padding" style="padding: 24px 32px 0 32px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                         style="border-collapse: collapse;">
                     <tr>
                        <td bgcolor="#2457a6" style="border-radius: 3px;">
                           <a href="{{ ResetUrl }}"
                              style="display: inline-block; padding: 11px 22px; font-size: 14px; font-weight: 600;
                                     line-height: 20px; color: #ffffff; text-decoration: none; border-radius: 3px;">
                              Choose a new password
                           </a>
                        </td>
                     </tr>
                  </table>
               </td>
            </tr>

            <!-- Expiry notice -->
            <tr>
               <td class="content-padding" style="padding: 20px 32px 0 32px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                         style="border-collapse: collapse; width: 100%; background-color: #fff5df;
                                border: 1px solid #f2e2bd; border-radius: 4px;">
                     <tr>
                        <td style="padding: 12px 16px; font-size: 13px; line-height: 20px; color: #a56800;">
                           This link works once and expires in {{ ExpiresInMinutes }} minutes. After that, request
                           a new reset from the sign-in page.
                        </td>
                     </tr>
                  </table>
               </td>
            </tr>

            <!-- Link fallback -->
            <tr>
               <td class="content-padding" style="padding: 20px 32px 0 32px;">
                  <p style="margin: 0 0 6px 0; font-size: 12px; line-height: 18px; color: #87919d;">
                     If the button does not work, paste this address into your browser:
                  </p>
                  <p style="margin: 0; font-size: 12px; line-height: 18px; word-break: break-all;">
                     <a href="{{ ResetUrl }}" style="color: #2457a6; text-decoration: none;">{{ ResetUrl }}</a>
                  </p>
               </td>
            </tr>

            <!-- Safety note -->
            <tr>
               <td class="content-padding" style="padding: 24px 32px 28px 32px;">
                  <div style="height: 1px; line-height: 1px; font-size: 0; background-color: #e9edf1;">&nbsp;</div>
                  <p style="margin: 16px 0 0 0; font-size: 12px; line-height: 18px; color: #87919d;">
                     Did not ask for this? You can ignore this message &mdash; your current password stays active
                     and nobody gains access to your account.
                  </p>
               </td>
            </tr>

            {% include "Mail/footer" %}

         </table>
         <!--[if mso]>
         </td></tr></table>
         <![endif]-->
      </td>
   </tr>
</table>

</body>
</html>
