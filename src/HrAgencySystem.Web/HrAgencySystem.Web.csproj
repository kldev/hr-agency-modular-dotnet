<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3efd8ec9-a40b-415d-920c-80b5c80b5d55</UserSecretsId>
  </PropertyGroup>

  <!--
    No module references on purpose. This host reads and writes through the API's internal
    routes, so it carries no database credentials and no module has to keep a "minimal" variant
    alive for it. Observability is the one exception: it is plumbing every host shares, not a
    module, and it knows nothing about the domain.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Observability\HrAgencySystem.Observability.AspNetCore\HrAgencySystem.Observability.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Common\" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="wwwroot\js\site.js" />
    <_ContentIncludedByDefault Remove="Pages\Shared\_Layout.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\Shared\_ValidationScriptsPartial.cshtml" />
  </ItemGroup>
</Project>
